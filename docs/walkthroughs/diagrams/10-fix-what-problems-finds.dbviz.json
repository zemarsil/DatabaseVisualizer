      "id": "tbl_v_customer_orders",
      "name": "v_customer_orders",
      "kind": "view",
      "groupId": "grp_shop",
      "comment": "Read-only summary for the account page: how many orders a customer has placed and what they have spent. Computed on every read, never stored.",
      "viewSql": "SELECT c.id AS customer_id,\n       c.email,\n       COUNT(DISTINCT o.id) AS order_count,\n       COALESCE(SUM(oi.quantity * oi.unit_price_cents), 0) AS total_cents\nFROM customers c\nJOIN orders o ON o.customer_id = c.id\nJOIN order_items oi ON oi.order_id = o.id\nGROUP BY c.id, c.email",
      "position": {
        "x": 1020,
        "y": 900
      },
      "columns": [
        {
          "id": "col_vco_customer_id",
          "name": "customer_id",
          "type": "BIGINT",
          "nullable": false,
          "primaryKey": false,
          "unique": false,
          "autoIncrement": false
        },
        {
          "id": "col_vco_email",
          "name": "email",
          "type": "TEXT",
          "nullable": false,
          "primaryKey": false,
          "unique": false,
          "autoIncrement": false
        },
        {
          "id": "col_vco_order_count",
          "name": "order_count",
          "type": "INTEGER",
          "nullable": false,
          "primaryKey": false,
          "unique": false,
          "autoIncrement": false
        },
        {
          "id": "col_vco_total_cents",
          "name": "total_cents",
          "type": "INTEGER",
          "nullable": false,
          "primaryKey": false,
          "unique": false,
          "autoIncrement": false
        }
      ]
    },
