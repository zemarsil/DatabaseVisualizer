{
  "version": 1,
  "name": "Run the schema on a real database — bookshop orders",
  "dialect": "postgresql",
  "customTypes": [
    {
      "id": "typ_order_status",
      "name": "order_status",
      "kind": "enum",
      "values": ["pending", "paid", "shipped", "cancelled"],
      "comment": "The order lifecycle. PostgreSQL creates a real CREATE TYPE for this; MariaDB would inline ENUM(...) and SQLite would fall back to a CHECK."
    }
  ],
  "tables": [
    {
      "id": "tbl_authors",
      "name": "authors",
      "schema": "public",
      "color": "blue",
      "comment": "One row per person who wrote something we sell.",
      "position": { "x": 0, "y": 0 },
      "checks": [],
      "indexes": [],
      "columns": [
        { "id": "col_authors_id", "name": "id", "type": "BIGSERIAL", "nullable": false, "primaryKey": true, "unique": false, "autoIncrement": true },
        { "id": "col_authors_name", "name": "name", "type": "TEXT", "nullable": false, "primaryKey": false, "unique": false, "autoIncrement": false },
        { "id": "col_authors_country", "name": "country", "type": "CHAR(2)", "nullable": true, "primaryKey": false, "unique": false, "autoIncrement": false, "comment": "ISO 3166-1 alpha-2. Nullable: we often do not know." }
      ]
    },
    {
      "id": "tbl_customers",
      "name": "customers",
      "schema": "public",
      "color": "blue",
      "comment": "One row per person who has placed at least one order.",
      "position": { "x": 320, "y": 0 },
      "checks": [],
      "indexes": [],
      "columns": [
        { "id": "col_customers_id", "name": "id", "type": "BIGSERIAL", "nullable": false, "primaryKey": true, "unique": false, "autoIncrement": true },
        { "id": "col_customers_email", "name": "email", "type": "TEXT", "nullable": false, "primaryKey": false, "unique": true, "autoIncrement": false },
        { "id": "col_customers_created_at", "name": "created_at", "type": "TIMESTAMPTZ", "nullable": false, "primaryKey": false, "unique": false, "autoIncrement": false, "defaultValue": "now()" }
      ]
    },
    {
      "id": "tbl_books",
      "name": "books",
      "schema": "public",
      "color": "blue",
      "comment": "One row per edition we stock.",
      "position": { "x": 0, "y": 260 },
      "checks": [],
      "indexes": [
        { "id": "idx_books_author_id", "name": "books_author_id_idx", "columnIds": ["col_books_author_id"], "unique": false }
      ],
      "columns": [
        { "id": "col_books_id", "name": "id", "type": "BIGSERIAL", "nullable": false, "primaryKey": true, "unique": false, "autoIncrement": true },
        { "id": "col_books_author_id", "name": "author_id", "type": "BIGINT", "nullable": false, "primaryKey": false, "unique": false, "autoIncrement": false },
        { "id": "col_books_title", "name": "title", "type": "TEXT", "nullable": false, "primaryKey": false, "unique": false, "autoIncrement": false },
        { "id": "col_books_isbn", "name": "isbn", "type": "CHAR(13)", "nullable": false, "primaryKey": false, "unique": true, "autoIncrement": false, "comment": "The natural key. UNIQUE, but not the primary key: ISBNs get reassigned and mistyped." },
        { "id": "col_books_price_cents", "name": "price_cents", "type": "INTEGER", "nullable": false, "primaryKey": false, "unique": false, "autoIncrement": false, "defaultValue": "0", "check": "price_cents >= 0", "comment": "Integer cents, never a float." },
        { "id": "col_books_published_on", "name": "published_on", "type": "DATE", "nullable": true, "primaryKey": false, "unique": false, "autoIncrement": false }
      ]
    },
    {
      "id": "tbl_orders",
      "name": "orders",
      "schema": "public",
      "color": "blue",
      "comment": "One row per checkout. status walks pending -> paid -> shipped, or -> cancelled.",
      "position": { "x": 320, "y": 260 },
      "checks": [],
      "indexes": [
        { "id": "idx_orders_customer_id", "name": "orders_customer_id_idx", "columnIds": ["col_orders_customer_id"], "unique": false }
      ],
      "columns": [
        { "id": "col_orders_id", "name": "id", "type": "BIGSERIAL", "nullable": false, "primaryKey": true, "unique": false, "autoIncrement": true },
        { "id": "col_orders_customer_id", "name": "customer_id", "type": "BIGINT", "nullable": false, "primaryKey": false, "unique": false, "autoIncrement": false },
        { "id": "col_orders_status", "name": "status", "type": "order_status", "nullable": false, "primaryKey": false, "unique": false, "autoIncrement": false, "defaultValue": "'pending'" },
        { "id": "col_orders_total_cents", "name": "total_cents", "type": "INTEGER", "nullable": false, "primaryKey": false, "unique": false, "autoIncrement": false, "defaultValue": "0", "check": "total_cents >= 0" },
        { "id": "col_orders_placed_at", "name": "placed_at", "type": "TIMESTAMPTZ", "nullable": false, "primaryKey": false, "unique": false, "autoIncrement": false, "defaultValue": "now()" }
      ]
    },
    {
      "id": "tbl_order_items",
      "name": "order_items",
      "schema": "public",
      "color": "blue",
      "comment": "The grain: one row per book within one order.",
      "position": { "x": 160, "y": 520 },
      "checks": [],
      "indexes": [
        { "id": "idx_order_items_order_id", "name": "order_items_order_id_idx", "columnIds": ["col_order_items_order_id"], "unique": false },
        { "id": "idx_order_items_book_id", "name": "order_items_book_id_idx", "columnIds": ["col_order_items_book_id"], "unique": false }
      ],
      "columns": [
        { "id": "col_order_items_id", "name": "id", "type": "BIGSERIAL", "nullable": false, "primaryKey": true, "unique": false, "autoIncrement": true },
        { "id": "col_order_items_order_id", "name": "order_id", "type": "BIGINT", "nullable": false, "primaryKey": false, "unique": false, "autoIncrement": false },
        { "id": "col_order_items_book_id", "name": "book_id", "type": "BIGINT", "nullable": false, "primaryKey": false, "unique": false, "autoIncrement": false },
        { "id": "col_order_items_quantity", "name": "quantity", "type": "INTEGER", "nullable": false, "primaryKey": false, "unique": false, "autoIncrement": false, "defaultValue": "1", "check": "quantity > 0" },
        { "id": "col_order_items_unit_price_cents", "name": "unit_price_cents", "type": "INTEGER", "nullable": false, "primaryKey": false, "unique": false, "autoIncrement": false, "check": "unit_price_cents >= 0", "comment": "Copied from books.price_cents at order time, so a later price change never rewrites history." }
      ]
    }
  ],
  "relationships": [
    {
      "id": "rel_books_author",
      "kind": "fk",
      "verb": "belongs-to",
      "sourceTableId": "tbl_books",
      "sourceColumnIds": ["col_books_author_id"],
      "targetTableId": "tbl_authors",
      "targetColumnIds": ["col_authors_id"],
      "name": "books_author_id_fkey"
    },
    {
      "id": "rel_orders_customer",
      "kind": "fk",
      "verb": "belongs-to",
      "sourceTableId": "tbl_orders",
      "sourceColumnIds": ["col_orders_customer_id"],
      "targetTableId": "tbl_customers",
      "targetColumnIds": ["col_customers_id"],
      "name": "orders_customer_id_fkey"
    },
    {
      "id": "rel_order_items_order",
      "kind": "fk",
      "verb": "belongs-to",
      "sourceTableId": "tbl_order_items",
      "sourceColumnIds": ["col_order_items_order_id"],
      "targetTableId": "tbl_orders",
      "targetColumnIds": ["col_orders_id"],
      "name": "order_items_order_id_fkey",
      "onDelete": "CASCADE"
    },
    {
      "id": "rel_order_items_book",
      "kind": "fk",
      "verb": "belongs-to",
      "sourceTableId": "tbl_order_items",
      "sourceColumnIds": ["col_order_items_book_id"],
      "targetTableId": "tbl_books",
      "targetColumnIds": ["col_books_id"],
      "name": "order_items_book_id_fkey"
    }
  ],
  "notes": [
    {
      "id": "note_run_it",
      "text": "This diagram is meant to be opened and actually run.\n\nPostgreSQL and MariaDB are real databases the local API server (npm run dev, port 8787) connects to over the network, so they need Docker (or any reachable server) and never leave your machine. SQLite runs a different way: entirely inside this browser tab, no server or Docker at all.\n\nDatabase tab, top to bottom: Docker -> Connection -> Create the schema -> Query -> Migrate -> Seed data -> Import from the database.",
      "position": { "x": 660, "y": 0 },
      "width": 320,
      "height": 260,
      "color": "yellow"
    }
  ]
}
