          "type": "CHAR(2)",
          "nullable": true,
          "primaryKey": false,
          "unique": false,
          "autoIncrement": false,
          "check": "country = upper(country)",
          "comment": "ISO 3166-1 alpha-2. Nullable: we often do not know."
        }
      ]
    },
    {
      "schema": "public",
