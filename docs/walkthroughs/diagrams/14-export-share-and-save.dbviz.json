{
  "version": 1,
  "name": "Export, share and save — bookshop",
  "dialect": "postgresql",
  "customTypes": [
    {
      "id": "typ_order_status",
      "name": "order_status",
      "kind": "enum",
      "values": ["pending", "paid", "shipped", "cancelled"],
      "comment": "PostgreSQL emits this as CREATE TYPE ... AS ENUM. Only the .dbviz.json and the SQL script keep it as a real type — Mermaid and DBML flatten it to a plain column type."
    }
  ],
  "groups": [
    {
      "id": "grp_crm",
      "name": "CRM (read-only)",
      "color": "purple",
      "external": true,
      "note": "Vendor CRM, reached over a foreign data wrapper. Marking the group external keeps crm_contacts out of the generated CREATE TABLE script.",
      "position": { "x": 0, "y": -360 }
    }
  ],
  "tables": [
    {
      "id": "tbl_authors",
      "name": "authors",
      "schema": "public",
      "color": "blue",
      "comment": "One row per person who wrote something we sell.",
      "position": { "x": 0, "y": 0 },
      "checks": [],
      "indexes": [],
      "columns": [
        { "id": "col_authors_id", "name": "id", "type": "BIGSERIAL", "nullable": false, "primaryKey": true, "unique": false, "autoIncrement": true },
        { "id": "col_authors_name", "name": "name", "type": "TEXT", "nullable": false, "primaryKey": false, "unique": false, "autoIncrement": false },
        { "id": "col_authors_country", "name": "country", "type": "CHAR(2)", "nullable": true, "primaryKey": false, "unique": false, "autoIncrement": false, "comment": "ISO 3166-1 alpha-2." }
      ]
    },
    {
      "id": "tbl_books",
      "name": "books",
      "schema": "public",
      "color": "blue",
      "comment": "One row per edition we stock.",
      "position": { "x": 320, "y": 0 },
      "checks": [],
      "indexes": [{ "id": "idx_books_author", "name": "books_author_id_idx", "columnIds": ["col_books_author_id"], "unique": false }],
      "columns": [
        { "id": "col_books_id", "name": "id", "type": "BIGSERIAL", "nullable": false, "primaryKey": true, "unique": false, "autoIncrement": true },
        { "id": "col_books_author_id", "name": "author_id", "type": "BIGINT", "nullable": false, "primaryKey": false, "unique": false, "autoIncrement": false },
        { "id": "col_books_title", "name": "title", "type": "TEXT", "nullable": false, "primaryKey": false, "unique": false, "autoIncrement": false },
        { "id": "col_books_isbn", "name": "isbn", "type": "CHAR(13)", "nullable": false, "primaryKey": false, "unique": true, "autoIncrement": false, "comment": "The natural key. UNIQUE, but not the primary key." },
        { "id": "col_books_price_cents", "name": "price_cents", "type": "INTEGER", "nullable": false, "primaryKey": false, "unique": false, "autoIncrement": false, "defaultValue": "0", "check": "price_cents >= 0" }
      ]
    },
    {
      "id": "tbl_customers",
      "name": "customers",
      "schema": "public",
      "color": "blue",
      "comment": "Shoppers. crm_contact_id points into the CRM group below.",
      "position": { "x": 640, "y": 0 },
      "checks": [],
      "indexes": [{ "id": "idx_customers_crm_contact", "name": "customers_crm_contact_id_idx", "columnIds": ["col_customers_crm_contact_id"], "unique": false }],
      "columns": [
        { "id": "col_customers_id", "name": "id", "type": "BIGSERIAL", "nullable": false, "primaryKey": true, "unique": false, "autoIncrement": true },
        { "id": "col_customers_email", "name": "email", "type": "TEXT", "nullable": false, "primaryKey": false, "unique": true, "autoIncrement": false },
        { "id": "col_customers_crm_contact_id", "name": "crm_contact_id", "type": "BIGINT", "nullable": true, "primaryKey": false, "unique": false, "autoIncrement": false, "comment": "References crm_contacts, which lives in another database." },
        { "id": "col_customers_created_at", "name": "created_at", "type": "TIMESTAMPTZ", "nullable": false, "primaryKey": false, "unique": false, "autoIncrement": false, "defaultValue": "now()" }
      ]
    },
    {
      "id": "tbl_orders",
      "name": "orders",
      "schema": "public",
      "color": "blue",
      "comment": "One row per order. status is the order_status enum below.",
      "position": { "x": 960, "y": 0 },
      "checks": ["total_cents >= 0"],
      "indexes": [{ "id": "idx_orders_customer", "name": "orders_customer_id_idx", "columnIds": ["col_orders_customer_id"], "unique": false }],
      "columns": [
        { "id": "col_orders_id", "name": "id", "type": "BIGSERIAL", "nullable": false, "primaryKey": true, "unique": false, "autoIncrement": true },
        { "id": "col_orders_customer_id", "name": "customer_id", "type": "BIGINT", "nullable": false, "primaryKey": false, "unique": false, "autoIncrement": false },
        { "id": "col_orders_status", "name": "status", "type": "order_status", "nullable": false, "primaryKey": false, "unique": false, "autoIncrement": false, "defaultValue": "'pending'" },
        { "id": "col_orders_total_cents", "name": "total_cents", "type": "INTEGER", "nullable": false, "primaryKey": false, "unique": false, "autoIncrement": false, "defaultValue": "0" },
        { "id": "col_orders_placed_at", "name": "placed_at", "type": "TIMESTAMPTZ", "nullable": false, "primaryKey": false, "unique": false, "autoIncrement": false, "defaultValue": "now()" }
      ]
    },
    {
      "id": "tbl_crm_contacts",
      "name": "crm_contacts",
      "color": "purple",
      "groupId": "grp_crm",
      "comment": "Their table, shown so the join is visible. Never created by our script.",
      "position": { "x": 0, "y": -300 },
      "checks": [],
      "indexes": [],
      "columns": [
        { "id": "col_crm_contact_id", "name": "contact_id", "type": "BIGINT", "nullable": false, "primaryKey": true, "unique": false, "autoIncrement": false },
        { "id": "col_crm_email", "name": "email", "type": "TEXT", "nullable": false, "primaryKey": false, "unique": true, "autoIncrement": false }
      ]
    },
    {
      "id": "tbl_v_order_summary",
      "name": "v_order_summary",
      "schema": "public",
      "kind": "view",
      "color": "teal",
      "comment": "What a dashboard would actually select from.",
      "viewSql": "SELECT c.id AS customer_id,\n       c.email,\n       o.id AS order_id,\n       o.status,\n       o.total_cents,\n       o.placed_at\nFROM customers c\nJOIN orders o ON o.customer_id = c.id",
      "position": { "x": 960, "y": 300 },
      "checks": [],
      "indexes": [],
      "columns": [
        { "id": "col_vos_customer_id", "name": "customer_id", "type": "BIGINT", "nullable": false, "primaryKey": false, "unique": false, "autoIncrement": false },
        { "id": "col_vos_email", "name": "email", "type": "TEXT", "nullable": false, "primaryKey": false, "unique": false, "autoIncrement": false },
        { "id": "col_vos_order_id", "name": "order_id", "type": "BIGINT", "nullable": false, "primaryKey": false, "unique": false, "autoIncrement": false },
        { "id": "col_vos_status", "name": "status", "type": "order_status", "nullable": false, "primaryKey": false, "unique": false, "autoIncrement": false },
        { "id": "col_vos_total_cents", "name": "total_cents", "type": "INTEGER", "nullable": false, "primaryKey": false, "unique": false, "autoIncrement": false },
        { "id": "col_vos_placed_at", "name": "placed_at", "type": "TIMESTAMPTZ", "nullable": false, "primaryKey": false, "unique": false, "autoIncrement": false }
      ]
    }
  ],
  "relationships": [
    {
      "id": "rel_books_authors",
      "kind": "fk",
      "verb": "belongs-to",
      "sourceTableId": "tbl_books",
      "sourceColumnIds": ["col_books_author_id"],
      "targetTableId": "tbl_authors",
      "targetColumnIds": ["col_authors_id"],
      "name": "books_author_id_fkey",
      "onDelete": "RESTRICT",
      "onUpdate": "NO ACTION"
    },
    {
      "id": "rel_orders_customers",
      "kind": "fk",
      "verb": "belongs-to",
      "sourceTableId": "tbl_orders",
      "sourceColumnIds": ["col_orders_customer_id"],
      "targetTableId": "tbl_customers",
      "targetColumnIds": ["col_customers_id"],
      "name": "orders_customer_id_fkey",
      "onDelete": "CASCADE",
      "onUpdate": "NO ACTION"
    },
    {
      "id": "rel_customers_crm",
      "kind": "fk",
      "verb": "references",
      "sourceTableId": "tbl_customers",
      "sourceColumnIds": ["col_customers_crm_contact_id"],
      "targetTableId": "tbl_crm_contacts",
      "targetColumnIds": ["col_crm_contact_id"],
      "name": "customers_crm_contact_id_fkey",
      "note": "crm_contacts lives in the CRM group, so the script documents this link in an External sources appendix instead of emitting a constraint.",
      "onDelete": "SET NULL",
      "onUpdate": "NO ACTION"
    },
    {
      "id": "rel_view_customers",
      "kind": "flow",
      "name": "view source",
      "sourceTableId": "tbl_customers",
      "sourceColumnIds": [],
      "targetTableId": "tbl_v_order_summary",
      "targetColumnIds": [],
      "note": "Linked by v_order_summary's Detect from SQL: customers is joined in its FROM clause."
    },
    {
      "id": "rel_view_orders",
      "kind": "flow",
      "name": "view source",
      "sourceTableId": "tbl_orders",
      "sourceColumnIds": [],
      "targetTableId": "tbl_v_order_summary",
      "targetColumnIds": [],
      "note": "Linked by v_order_summary's Detect from SQL: orders is joined in its FROM clause."
    }
  ],
  "notes": [
    {
      "id": "note_exports",
      "text": "This diagram exists to be exported. It carries a foreign key, a view, an external group, an enum and this very note — open the SQL tab and switch formats to see which of those survive each one.",
      "position": { "x": 0, "y": 300 },
      "width": 300,
      "height": 150,
      "color": "yellow"
    }
  ]
}
