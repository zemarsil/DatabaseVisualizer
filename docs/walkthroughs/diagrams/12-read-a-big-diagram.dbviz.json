    {
      "id": "tbl_v_book_sales",
      "name": "v_book_sales",
      "kind": "view",
      "color": "teal",
      "comment": "What a bookseller dashboard actually reads. Never touches order_items or orders directly — everything here comes through the rollup.",
      "viewSql": "SELECT b.id AS book_id,\n       b.title,\n       SUM(d.units) AS total_units,\n       SUM(d.revenue_cents) AS total_revenue_cents\nFROM books b\nJOIN daily_sales d ON d.book_id = b.id\nGROUP BY b.id, b.title",
      "position": { "x": 1280, "y": 1300 },
      "checks": [],
      "indexes": [],
      "columns": [
        { "id": "col_vbs_book_id", "name": "book_id", "type": "BIGINT", "nullable": true, "primaryKey": false, "unique": false, "autoIncrement": false },
        { "id": "col_vbs_title", "name": "title", "type": "TEXT", "nullable": true, "primaryKey": false, "unique": false, "autoIncrement": false },
        { "id": "col_vbs_total_units", "name": "total_units", "type": "INTEGER", "nullable": true, "primaryKey": false, "unique": false, "autoIncrement": false },
        { "id": "col_vbs_total_revenue_cents", "name": "total_revenue_cents", "type": "BIGINT", "nullable": true, "primaryKey": false, "unique": false, "autoIncrement": false }
      ]
    }
