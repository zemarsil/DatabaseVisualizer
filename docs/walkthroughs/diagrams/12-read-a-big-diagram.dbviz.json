    {
      "id": "rel_cadence_customer",
      "kind": "fk",
      "verb": "references",
      "sourceTableId": "tbl_customer_cadence",
      "sourceColumnIds": ["col_cadence_customer_id"],
      "targetTableId": "tbl_customers",
      "targetColumnIds": ["col_customers_id"],
      "name": "customer_cadence_customer_id_fkey",
      "onDelete": "NO ACTION",
      "onUpdate": "NO ACTION"
    },
    {
      "id": "rel_flow_daily_sales",
      "kind": "flow",
      "verb": "feeds",
      "sourceTableId": "tbl_order_items",
      "sourceColumnIds": [],
      "targetTableId": "tbl_daily_sales",
      "targetColumnIds": [],
      "name": "nightly rollup",
      "note": "Runs at 02:00 via cron. The composite primary key (day, book_id) makes it safe to rerun.",
      "derivations": [
        { "id": "drv_daily_day", "targetColumnId": "col_daily_day", "expression": "CAST(orders.placed_at AS DATE)", "groupBy": ["book_id", "CAST(orders.placed_at AS DATE)"], "filter": "orders.status = 'paid'" },
        { "id": "drv_daily_units", "targetColumnId": "col_daily_units", "expression": "quantity", "aggregate": "SUM", "groupBy": ["book_id", "CAST(orders.placed_at AS DATE)"], "filter": "orders.status = 'paid'" },
        { "id": "drv_daily_revenue", "targetColumnId": "col_daily_revenue_cents", "expression": "quantity * unit_price_cents", "aggregate": "SUM", "groupBy": ["book_id", "CAST(orders.placed_at AS DATE)"], "filter": "orders.status = 'paid'" }
      ],
      "query": "INSERT INTO daily_sales (day, book_id, units, revenue_cents)\nSELECT o.placed_at::date, oi.book_id,\n       SUM(oi.quantity), SUM(oi.quantity * oi.unit_price_cents)\nFROM order_items oi\nJOIN orders o ON o.id = oi.order_id\nWHERE o.status = 'paid'\nGROUP BY 1, 2;"
    },
    {
      "id": "rel_flow_cadence",
      "kind": "flow",
      "verb": "feeds",
      "sourceTableId": "tbl_orders",
      "sourceColumnIds": [],
      "targetTableId": "tbl_customer_cadence",
      "targetColumnIds": [],
      "name": "cadence rollup",
      "note": "The first paid order of a customer has no previous one, so its gap is NULL and AVG ignores it.",
      "derivations": [
        { "id": "drv_cadence_avg_gap", "targetColumnId": "col_cadence_avg_gap_days", "expression": "CAST(placed_at AS DATE)", "aggregate": "AVG", "groupBy": ["customer_id"], "filter": "status = 'paid'", "window": { "fn": "DIFF", "orderBy": ["placed_at"], "partitionBy": ["customer_id"] } },
        { "id": "drv_cadence_order_count", "targetColumnId": "col_cadence_order_count", "expression": "*", "aggregate": "COUNT", "groupBy": ["customer_id"], "filter": "status = 'paid'" }
      ],
      "query": "WITH paid AS (\n  SELECT customer_id, placed_at::date AS d,\n         placed_at::date - LAG(placed_at::date) OVER (PARTITION BY customer_id ORDER BY placed_at) AS gap_days\n  FROM orders WHERE status = 'paid'\n)\nINSERT INTO customer_cadence (customer_id, avg_gap_days, order_count)\nSELECT customer_id, AVG(gap_days), COUNT(*)\nFROM paid\nGROUP BY customer_id;"
    },
    {
      "id": "rel_view_books",
      "kind": "flow",
      "sourceTableId": "tbl_books",
      "sourceColumnIds": [],
      "targetTableId": "tbl_v_book_sales",
      "targetColumnIds": [],
      "name": "view source",
      "note": "books is named in the view's FROM clause."
    },
    {
      "id": "rel_view_daily",
      "kind": "flow",
      "sourceTableId": "tbl_daily_sales",
      "sourceColumnIds": [],
      "targetTableId": "tbl_v_book_sales",
      "targetColumnIds": [],
      "name": "view source",
      "note": "daily_sales is the table the view's SELECT actually aggregates."
    }
  ],
  "notes": [
    {
      "id": "note_scale",
      "text": "This is the bookshop schema at a size where it stops fitting on one screen — 11 tables across two schemas, plus an external CRM and a rollup-fed view.\n\norder_items and crm_contacts are saved collapsed (Keys only / Header only): the display mode travels with the file, not just this session.\n\nPress L to Detangle, select a table and press . to see its neighbourhood, Ctrl+K to jump anywhere by name.",
      "position": { "x": 1600, "y": 0 },
      "width": 320,
      "height": 230,
      "color": "yellow"
    }
  ]
}
