  "notes": [
    {
      "id": "note_types",
      "text": "A custom type is a type, not a table.\n\nYou use it by typing its name into a column's type cell — the same way you type TEXT — and the generated script emits CREATE TYPE before the tables that need it.\n\nEnum: a closed set of values. Composite: a fixed record with named fields.",
      "position": {
        "x": 1780,
        "y": 0
      },
      "width": 330,
      "height": 230,
      "color": "yellow"
    }
  ]
