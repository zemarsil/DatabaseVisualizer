{
  "version": 1,
  "name": "Orders rollup — advisor recommendation",
  "dialect": "postgresql",
  "tables": [
    {
      "id": "tbl_customers",
      "name": "customers",
      "schema": "public",
      "color": "blue",
      "comment": "Unchanged source table.",
      "position": { "x": 0, "y": 0 },
      "checks": [],
      "columns": [
        { "id": "col_customers_id", "name": "id", "type": "BIGSERIAL", "nullable": false, "primaryKey": true, "unique": false, "autoIncrement": true },
        { "id": "col_customers_email", "name": "email", "type": "CITEXT", "nullable": false, "primaryKey": false, "unique": true, "autoIncrement": false, "comment": "CITEXT rather than lower(email) + expression index: the equality lookup is the only access pattern." },
        { "id": "col_customers_created_at", "name": "created_at", "type": "TIMESTAMPTZ", "nullable": false, "primaryKey": false, "unique": false, "autoIncrement": false, "defaultValue": "now()" }
      ],
      "indexes": []
    },
    {
      "id": "tbl_orders",
      "name": "orders",
      "schema": "public",
      "color": "blue",
      "comment": "Store money as integer cents; NUMERIC(12,2) only if you need exact decimal arithmetic in the DB.",
      "position": { "x": 320, "y": 0 },
      "checks": ["total_cents >= 0"],
      "columns": [
        { "id": "col_orders_id", "name": "id", "type": "BIGSERIAL", "nullable": false, "primaryKey": true, "unique": false, "autoIncrement": true },
        { "id": "col_orders_customer_id", "name": "customer_id", "type": "BIGINT", "nullable": false, "primaryKey": false, "unique": false, "autoIncrement": false },
        { "id": "col_orders_total_cents", "name": "total_cents", "type": "BIGINT", "nullable": false, "primaryKey": false, "unique": false, "autoIncrement": false, "defaultValue": "0" },
        { "id": "col_orders_placed_at", "name": "placed_at", "type": "TIMESTAMPTZ", "nullable": false, "primaryKey": false, "unique": false, "autoIncrement": false, "defaultValue": "now()" }
      ],
      "indexes": [
        { "id": "idx_orders_customer_placed", "name": "orders_customer_id_placed_at_idx", "columnIds": ["col_orders_customer_id", "col_orders_placed_at"], "unique": false }
      ]
    },
    {
      "id": "tbl_customer_month",
      "name": "customer_month_totals",
      "schema": "public",
      "color": "orange",
      "comment": "New: monthly rollup maintained on write. The dashboard query drops from a full scan of orders to a single-row lookup.",
      "position": { "x": 160, "y": 260 },
      "checks": [],
      "columns": [
        { "id": "col_cm_customer_id", "name": "customer_id", "type": "BIGINT", "nullable": false, "primaryKey": true, "unique": false, "autoIncrement": false },
        { "id": "col_cm_month", "name": "month", "type": "DATE", "nullable": false, "primaryKey": true, "unique": false, "autoIncrement": false, "comment": "First day of the month; date_trunc('month', placed_at)::date." },
        { "id": "col_cm_order_count", "name": "order_count", "type": "INTEGER", "nullable": false, "primaryKey": false, "unique": false, "autoIncrement": false, "defaultValue": "0" },
        { "id": "col_cm_total_cents", "name": "total_cents", "type": "BIGINT", "nullable": false, "primaryKey": false, "unique": false, "autoIncrement": false, "defaultValue": "0" }
      ],
      "indexes": []
    }
  ],
  "relationships": [
    {
      "id": "rel_orders_customer",
      "kind": "fk",
      "sourceTableId": "tbl_orders",
      "sourceColumnIds": ["col_orders_customer_id"],
      "targetTableId": "tbl_customers",
      "targetColumnIds": ["col_customers_id"],
      "name": "orders_customer_id_fkey",
      "onDelete": "CASCADE",
      "onUpdate": "NO ACTION"
    },
    {
      "id": "rel_cm_customer",
      "kind": "fk",
      "sourceTableId": "tbl_customer_month",
      "sourceColumnIds": ["col_cm_customer_id"],
      "targetTableId": "tbl_customers",
      "targetColumnIds": ["col_customers_id"],
      "name": "customer_month_totals_customer_id_fkey",
      "onDelete": "CASCADE",
      "onUpdate": "NO ACTION"
    },
    {
      "id": "rel_flow_orders_rollup",
      "kind": "flow",
      "sourceTableId": "tbl_orders",
      "sourceColumnIds": [],
      "targetTableId": "tbl_customer_month",
      "targetColumnIds": [],
      "name": "maintained at ingest",
      "note": "Do this in the same transaction as the INSERT into orders, not in a nightly job: the dashboard reads it seconds after the write.",
      "query": "INSERT INTO customer_month_totals (customer_id, month, order_count, total_cents)\nVALUES (NEW.customer_id, date_trunc('month', NEW.placed_at)::date, 1, NEW.total_cents)\nON CONFLICT (customer_id, month) DO UPDATE\n  SET order_count = customer_month_totals.order_count + 1,\n      total_cents = customer_month_totals.total_cents + EXCLUDED.total_cents;"
    }
  ],
  "notes": [
    {
      "id": "note_summary",
      "text": "Recommendation: keep the aggregate where it is read, not where it is written from.\n\n1. Add customer_month_totals, maintained by the upsert on the dashed edge.\n2. Composite index (customer_id, placed_at) on orders serves the drill-down; the leading column must be customer_id because every query filters on it.\n3. Money stays in integer cents.",
      "position": { "x": 660, "y": 250 },
      "width": 320,
      "height": 190,
      "color": "yellow"
    },
    {
      "id": "note_not_modelled",
      "text": "Not representable in the diagram: consider partitioning orders BY RANGE (placed_at) once it passes ~50M rows. The DDL generated here is the unpartitioned table.",
      "position": { "x": 660, "y": 470 },
      "width": 320,
      "height": 130,
      "color": "slate"
    }
  ]
}
