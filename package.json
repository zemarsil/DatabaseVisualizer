{
  "name": "coditect",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Draw what your system is made of: map code as programs, modules, classes and functions, design database schemas as tables and keys, or both on one canvas — with SQL generated, codebases scanned, paths traced and the schema pushed to a Docker-hosted PostgreSQL or MariaDB.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "check:docs": "node scripts/validate-walkthrough.mjs && node scripts/build-walkthrough-index.mjs --check",
    "scan:code": "python3 scripts/scan_code.py",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@duckdb/duckdb-wasm": "^1.32.0",
    "@xyflow/react": "^12.11.6",
    "apache-arrow": "^17.0.0",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dockerode": "^5.0.1",
    "express": "^5.2.1",
    "html-to-image": "^1.11.13",
    "immer": "^10.2.0",
    "lucide-react": "^1.41.0",
    "mariadb": "^3.5.4",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sql.js": "^1.14.2",
    "tsx": "^4.23.13",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/cors": "^2.8.19",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^10.0.5",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild": true,
    "cpu-features": false,
    "protobufjs": false,
    "ssh2": false
  }
}
